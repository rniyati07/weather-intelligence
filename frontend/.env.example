# ---------------------------------------------------------------------------
# Weather Intelligence Service — frontend environment
# Copy to `.env.local` (git-ignored) and fill in.
# ---------------------------------------------------------------------------

# --- Public (VITE_* is INLINED INTO THE BROWSER BUNDLE — never put secrets here)

# Same-origin path the browser calls. The dev proxy in vite.config.ts (and the
# production BFF) forwards this to the FastAPI service and adds the API key.
VITE_API_BASE_URL=/api/v1

# Request timeout in milliseconds. A chat turn is the long pole: one request
# fans out to geocoding, the weather providers, a live Overpass places search
# and two LLM calls before the response is written, so the ceiling has to
# clear all of that with room to spare.
VITE_API_TIMEOUT_MS=60000

# Shown in the footer alongside metadata.ruleConfigVersion.
VITE_APP_VERSION=1.0.0

# Toggle the TanStack Query devtools panel in development.
VITE_ENABLE_QUERY_DEVTOOLS=true


# --- Server-side only (NO VITE_ PREFIX — Vite will not expose these) ---------

# Where the dev proxy forwards /api.
API_PROXY_TARGET=http://localhost:8000

# Consumer API key. Injected as X-API-Key by the proxy, server-side.
API_KEY=

# Operator key for GET /providers/health. A consumer key gets 403 there.
OPS_API_KEY=
