# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Test / tool caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
coverage.xml
htmlcov/

# --- Environment & secrets ------------------------------------------------
# Real values live only in local, untracked files. `.env.example` (and the
# frontend's) document the variable names and are committed.
.env
.env.*
!.env.example

# --- Frontend -------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
frontend/.env.local
# Refreshed from the running backend; the generated types are what's committed.
frontend/openapi.json

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs / scratch -------------------------------------------------------
*.log
*.pid
logs/
tmp/
temp/

# --- Tooling output -------------------------------------------------------
.playwright-mcp/
