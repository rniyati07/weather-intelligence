# ---- Application ----
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- Auth ----
API_KEYS=dev_key_local
OPS_API_KEYS=dev_ops_key_local
RATE_LIMIT_PER_MINUTE=60

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://wis:wis@localhost:5432/wis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=redis
CACHE_TTL_PROVIDER_SECONDS=3600
CACHE_TTL_INTELLIGENCE_SECONDS=10800

# ---- Weather providers ----
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
METEOSTAT_API_KEY=
PROVIDER_PRIORITY_FORECAST=open_meteo,openweather,weatherapi
PROVIDER_PRIORITY_HISTORICAL=meteostat
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.3
PROVIDER_HEALTH_TTL_SECONDS=60

# ---- LLM (mandatory: startup fails without these three) ----
# Any OpenAI-compatible chat-completions API. Examples:
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#            LLM_MODEL=openai/gpt-oss-20b
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL=gemini-flash-latest
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
# Optional, reasoning models only (low | medium | high). "low" cuts the hidden
# reasoning tokens that count against a provider's tokens-per-minute limit, but
# in testing with openai/gpt-oss-20b it occasionally returned an empty extraction
# for a plain message, so it is left unset by default.
LLM_REASONING_EFFORT=

# ---- Domain rules ----
RULE_CONFIG_VERSION=2026.07
MAX_FORECAST_HORIZON_DAYS=16
